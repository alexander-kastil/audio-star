<Application x:Class="AudioStar.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AudioStar.Desktop.ViewModels"
             xmlns:views="clr-namespace:AudioStar.Desktop.Views"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NowPlayingViewModel}">
                <views:NowPlayingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QueueViewModel}">
                <views:QueueView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MyMusicViewModel}">
                <views:MyMusicView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HomeShareViewModel}">
                <views:HomeShareView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RadioViewModel}">
                <views:RadioView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SourceViewModel}">
                <views:SourceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecentViewModel}">
                <views:RecentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PresetsViewModel}">
                <views:PresetsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeviceSettingsViewModel}">
                <views:DeviceSettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AppSettingsViewModel}">
                <views:AppSettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
