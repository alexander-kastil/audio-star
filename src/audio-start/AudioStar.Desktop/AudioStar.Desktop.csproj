<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AudioStar.Core\AudioStar.Core.csproj" />
    <ProjectReference Include="..\AudioStar.Speakers\AudioStar.Speakers.csproj" />
    <ProjectReference Include="..\AudioStar.Devices\AudioStar.Devices.csproj" />
    <ProjectReference Include="..\AudioStar.Library\AudioStar.Library.csproj" />
    <ProjectReference Include="..\AudioStar.Sources\AudioStar.Sources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <AssemblyName>AudioStar</AssemblyName>
    <RootNamespace>AudioStar.Desktop</RootNamespace>
    <Version>1.1.0</Version>
  </PropertyGroup>

</Project>
