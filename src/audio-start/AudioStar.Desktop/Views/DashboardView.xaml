<UserControl x:Class="AudioStar.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AudioStar.Desktop.Views"
             xmlns:vm="clr-namespace:AudioStar.Desktop.ViewModels"
             xmlns:res="clr-namespace:AudioStar.Desktop.Resources">
    <UserControl.Resources>
        <DataTemplate x:Key="MemberTemplate" DataType="{x:Type vm:MemberVolumeViewModel}">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Member volume" ToolTip="Member volume" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="{Binding MuteGlyph}" Command="{Binding ToggleMuteCommand}" ToolTip="Mute member" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:SpeakerCardViewModel}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <views:CoverArt Source="{Binding CoverUri}" Width="76" Height="76" />
                        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" FontSize="11" />
                            <TextBlock Text="{Binding Track}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" Style="{StaticResource Subtle}" Visibility="{Binding Artist, Converter={StaticResource NotNullToVisibility}}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource PlayButton}" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayToolTip}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Volume" ToolTip="Volume" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE7F5;" Command="{Binding SelectCommand}" ToolTip="Control this speaker in the player bar" />
                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE70F;" Command="{Binding EditGroupCommand}" ToolTip="Edit group" Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE71B;" Command="{Binding UngroupCommand}" ToolTip="Ungroup" Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                    <Expander Header="Member volumes" Margin="0,8,0,0" Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Members}" ItemTemplate="{StaticResource MemberTemplate}" />
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMarginRoomy}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" Command="{Binding PlayAllCommand}" ToolTip="Play all" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE769;" Command="{Binding PauseAllCommand}" ToolTip="Pause all" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE71B;" Command="{Binding NewGroupCommand}" ToolTip="New group" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Search for speakers again" />
                </StackPanel>
                <TextBlock Text="Devices" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Speaker IP address" ToolTip="IP address of the speaker, for example 192.168.0.67" />
                <TextBlock Text="Add speaker by IP" Style="{StaticResource Subtle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0" Visibility="{Binding IpAddress, Converter={StaticResource NullToVisibility}}" />
                <Button Grid.Column="1" VerticalAlignment="Center" Content="Add" Margin="8,0,0,0" Command="{Binding AddSpeakerCommand}" ToolTip="Add this speaker" />
            </Grid>

            <TextBlock Text="Devices and groups" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <res:AdaptiveGrid MinItemWidth="340" MaxItemWidth="4000" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Style="{StaticResource EmptyState}"
                       Text="No speakers found yet. Make sure your speakers are on this network, or add one by its IP address."
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
