<UserControl x:Class="AudioStar.Desktop.Views.MiniBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AudioStar.Desktop.Views"
             MinHeight="92">
    <Grid Margin="14,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="240" />
            <ColumnDefinition Width="4*" MinWidth="360" />
            <ColumnDefinition Width="2*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Width="72"
                    Height="72"
                    Padding="0"
                    Command="{Binding ShowNowPlayingCommand}"
                    ToolTip="Open now playing"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0">
                <views:CoverArt Source="{Binding CoverUri}" Width="72" Height="72" />
            </Button>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Artist}" Style="{StaticResource Subtle}" Visibility="{Binding Artist, Converter={StaticResource NotNullToVisibility}}" />
                <Border Style="{StaticResource Badge}" Margin="0,4,0,0" Visibility="{Binding Quality, Converter={StaticResource NotNullToVisibility}}">
                    <TextBlock Text="{Binding Quality}" FontSize="11" Style="{StaticResource Subtle}" />
                </Border>
                <TextBlock Text="{Binding SpeakerName}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconToggleButton}"
                        Content="&#xE8B1;"
                        Tag="{Binding Shuffle}"
                        Command="{Binding ToggleShuffleCommand}"
                        ToolTip="Shuffle" />
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE892;"
                        Command="{Binding PreviousCommand}"
                        ToolTip="Previous track" />
                <Button Style="{StaticResource PlayButton}"
                        Margin="6,0"
                        Content="{Binding PlayGlyph}"
                        Command="{Binding PlayPauseCommand}"
                        ToolTip="{Binding PlayToolTip}" />
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE893;"
                        Command="{Binding NextCommand}"
                        ToolTip="Next track" />
                <Button Style="{StaticResource IconToggleButton}"
                        Content="{Binding RepeatGlyph}"
                        Tag="{Binding RepeatActive}"
                        Command="{Binding CycleRepeatCommand}"
                        ToolTip="{Binding RepeatToolTip}" />
            </StackPanel>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PositionText}" Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Slider x:Name="SeekSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=OneWay}"
                        IsMoveToPointEnabled="True"
                        IsEnabled="{Binding HasSpeaker}"
                        Visibility="{Binding HasDuration, Converter={StaticResource BoolToVisibility}}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Seek"
                        ToolTip="Seek" />
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}"
                    Content="{Binding MuteGlyph}"
                    Command="{Binding ToggleMuteCommand}"
                    ToolTip="Mute" />
            <Slider x:Name="VolumeSlider"
                    Width="120"
                    Minimum="0"
                    Maximum="100"
                    SmallChange="1"
                    LargeChange="5"
                    Value="{Binding Volume, Mode=TwoWay}"
                    IsEnabled="{Binding HasSpeaker}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Volume"
                    ToolTip="Volume" />
            <TextBlock Text="{Binding Volume, StringFormat={}{0:0}}" Width="30" TextAlignment="Right" Style="{StaticResource Subtle}" VerticalAlignment="Center" />
            <Button Style="{StaticResource IconButton}"
                    Margin="8,0,0,0"
                    Content="&#xE8FD;"
                    Command="{Binding ShowQueueCommand}"
                    ToolTip="Show queue" />
        </StackPanel>
    </Grid>
</UserControl>
