<UserControl x:Class="AudioStar.Desktop.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AudioStar.Desktop.Views"
             xmlns:res="clr-namespace:AudioStar.Desktop.Resources">
    <Grid Margin="{StaticResource PageMarginRoomy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Reload the queue" />
            <StackPanel>
                <TextBlock Text="Queue" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding QueueName}" Style="{StaticResource Subtle}" Visibility="{Binding QueueName, Converter={StaticResource NotNullToVisibility}}" />
            </StackPanel>
        </DockPanel>
        <ListView Grid.Row="1" Margin="{StaticResource ScrollGutterBelow14}" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,10,0" />
                    <Setter Property="res:Interaction.DoubleClickCommand" Value="{Binding DataContext.JumpCommand, RelativeSource={RelativeSource AncestorType=ListView}}" />
                    <Setter Property="ToolTip" Value="Double-click to play this track" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                        <views:CoverArt Grid.Column="1" Source="{Binding ArtworkUri}" Width="44" Height="44" CornerRadius="4" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource Subtle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="13" Content="&#xE74D;" Margin="8,0,0,0"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                CommandParameter="{Binding}"
                                ToolTip="Remove from queue" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="1" Style="{StaticResource EmptyState}" Text="{Binding EmptyText}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
