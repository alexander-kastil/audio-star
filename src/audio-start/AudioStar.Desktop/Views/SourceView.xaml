<UserControl x:Class="AudioStar.Desktop.Views.SourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AudioStar.Desktop.Views"
             xmlns:res="clr-namespace:AudioStar.Desktop.Resources">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Subtle}" TextTrimming="None" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVisibility}}" />
            <Grid Margin="0,12,0,0" Visibility="{Binding SupportsUrl, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding PlaylistUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Playlist URL" ToolTip="Paste the link of a playlist">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddPlaylistCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Add playlist by URL" Style="{StaticResource Subtle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0" Visibility="{Binding PlaylistUrl, Converter={StaticResource NullToVisibility}}" />
                <Button Grid.Column="1" VerticalAlignment="Center" Content="Add" Margin="8,0,0,0" Command="{Binding AddPlaylistCommand}" ToolTip="Add this playlist" />
            </Grid>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <ContextMenu x:Key="TrackColumnsMenu" x:Shared="False">
                    <MenuItem Header="#" IsCheckable="True" IsChecked="{Binding ShowNumber}" />
                    <MenuItem Header="Artist" IsCheckable="True" IsChecked="{Binding ShowArtist}" />
                </ContextMenu>
            </Grid.Resources>

            <TextBlock Text="Playlists" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" VerticalAlignment="Center" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding Playlists}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <res:AdaptiveGrid MinItemWidth="140" MaxItemWidth="320" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Title}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                                    <Setter Property="AutomationProperties.ItemStatus" Value="Now playing" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                    <Setter Property="ContextMenu">
                                                        <Setter.Value>
                                                            <ContextMenu>
                                                                <MenuItem Header="Settings..."
                                                                          Command="{Binding PlacementTarget.Tag.EditPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="Remove"
                                                                          Command="{Binding PlacementTarget.Tag.RemovePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            </ContextMenu>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <views:CoverArt Source="{Binding ArtworkUri}">
                                            <views:CoverArt.Height>
                                                <MultiBinding Converter="{StaticResource Multiply}">
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                    <Binding Path="DataContext.CoverRatio" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </views:CoverArt.Height>
                                        </views:CoverArt>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Subtle}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource EmptyState}" Text="No playlists yet. Connect, or add one by its link." Visibility="{Binding NoPlaylists, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource HairlineSplitter}" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          ToolTip="Drag to resize" AutomationProperties.Name="Resize playlists and tracks" />

            <DockPanel Grid.Column="2" Margin="0,0,0,8" Visibility="{Binding SelectedPlaylist, Converter={StaticResource NotNullToVisibility}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Play all" Command="{Binding PlayAllCommand}" ToolTip="Play the playlist on the current speaker" />
                    <Button DockPanel.Dock="Right" Margin="0,0,8,0" Command="{Binding ToggleViewCommand}" AutomationProperties.Name="Switch track view">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Setter Property="MinWidth" Value="44" />
                                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="Content" Value="&#xE80A;" />
                                <Setter Property="ToolTip" Value="Show tracks as cards" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CardView}" Value="True">
                                        <Setter Property="Content" Value="&#xE8FD;" />
                                        <Setter Property="ToolTip" Value="Show tracks as a list" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding SelectedPlaylist.Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <Grid Grid.Row="1" Grid.Column="2" Visibility="{Binding SelectedPlaylist, Converter={StaticResource NotNullToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="17,0,13,4" Background="Transparent" ContextMenu="{StaticResource TrackColumnsMenu}" ToolTip="Right-click to show or hide columns" Visibility="{Binding ListMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding NumberColumnWidth}" />
                        <ColumnDefinition Width="{Binding TitleColumnWidth, Mode=TwoWay}" MinWidth="80" />
                        <ColumnDefinition Width="{Binding ArtistColumnWidth, Mode=TwoWay}" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" Style="{StaticResource TrackHeader}" Visibility="{Binding ShowNumber, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource TrackHeader}" />
                    <GridSplitter Grid.Column="1" Style="{StaticResource HairlineSplitter}" HorizontalAlignment="Right" ResizeBehavior="CurrentAndNext"
                                  Visibility="{Binding ShowArtist, Converter={StaticResource BoolToVisibility}}" ToolTip="Drag to resize Title and Artist" AutomationProperties.Name="Resize title and artist" />
                    <TextBlock Grid.Column="2" Text="Artist" Style="{StaticResource TrackHeader}" Margin="12,0,0,0" Visibility="{Binding ShowArtist, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="3" Text="Time" Style="{StaticResource TrackHeader}" HorizontalAlignment="Right" />
                </Grid>
                <ListView Grid.Row="1" Margin="{StaticResource ScrollGutter}" ItemsSource="{Binding Tracks}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ContextMenu="{StaticResource TrackColumnsMenu}" Visibility="{Binding ListMode, Converter={StaticResource BoolToVisibility}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource TrackListItem}">
                            <Setter Property="Margin" Value="0,0,10,0" />
                            <Setter Property="res:Interaction.DoubleClickCommand" Value="{Binding DataContext.PlayFromCommand, RelativeSource={RelativeSource AncestorType=ListView}}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding DataContext.NumberColumnWidth, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                    <ColumnDefinition Width="{Binding DataContext.TitleColumnWidth, RelativeSource={RelativeSource AncestorType=ListView}}" MinWidth="80" />
                                    <ColumnDefinition Width="{Binding DataContext.ArtistColumnWidth, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <Grid Visibility="{Binding DataContext.ShowNumber, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource TrackSubtle}" Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AppAccentTextBrush}" VerticalAlignment="Center" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Now playing" />
                                </Grid>
                                <Border Grid.Column="1" Style="{StaticResource TrackDivider}"
                                        Visibility="{Binding DataContext.ShowArtist, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TrackTitle}" Margin="0,0,12,0" res:Interaction.FullTextToolTip="True" />
                                <TextBlock Grid.Column="2" Text="{Binding Artist}" Style="{StaticResource TrackSubtle}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" res:Interaction.FullTextToolTip="True"
                                           Visibility="{Binding DataContext.ShowArtist, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource TrackSubtle}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ListBox Grid.RowSpan="2" Margin="{StaticResource ScrollGutter}" ItemsSource="{Binding Tracks}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" Visibility="{Binding CardView, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Track cards">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <res:VirtualizingAdaptiveGrid MinItemWidth="140" MaxItemWidth="320" Spacing="12" Margin="0,0,10,0" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource TrackCardItem}">
                            <Setter Property="res:Interaction.DoubleClickCommand" Value="{Binding DataContext.PlayFromCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <Setter Property="ToolTip" Value="{Binding Details}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <views:CoverArt Source="{Binding ArtworkUri}">
                                    <views:CoverArt.Height>
                                        <MultiBinding Converter="{StaticResource Multiply}">
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                            <Binding Path="DataContext.CoverRatio" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        </MultiBinding>
                                    </views:CoverArt.Height>
                                </views:CoverArt>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource TrackTitle}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Artist}" Style="{StaticResource TrackSubtle}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource TrackSubtle}" FontSize="11" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
