<UserControl x:Class="AudioStar.Desktop.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AudioStar.Desktop.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMarginRoomy}">
            <TextBlock Text="Presets" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Save what is playing on the current speaker into a slot, then start it again with one click." Style="{StaticResource Subtle}" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="210" Margin="0,0,14,14">
                            <StackPanel>
                                <Grid>
                                    <views:CoverArt Source="{Binding PictureUri}" Width="184" Height="184" />
                                    <Border Background="#99000000" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                        <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBlock Text="{Binding Source}" Style="{StaticResource Subtle}" FontSize="12" MinHeight="16" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Play preset" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;"
                                            Command="{Binding DataContext.SaveCurrentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Save the current playback into this slot" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Delete preset" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource EmptyState}" Text="This speaker has no presets" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
