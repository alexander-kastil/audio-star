<UserControl x:Class="AudioStar.Desktop.Views.HomeShareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AudioStar.Desktop.Views"
             xmlns:res="clr-namespace:AudioStar.Desktop.Resources">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Home Share" Style="{StaticResource PageTitle}" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="Media server" ToolTip="Media server" />
            <TextBlock Text="Media server" Style="{StaticResource Subtle}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0" Visibility="{Binding SelectedServer, Converter={StaticResource NullToVisibility}}" />
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="8,0,0,0" Content="&#xE72B;" Command="{Binding UpCommand}" ToolTip="Up one level" IsEnabled="{Binding CanGoUp}" />
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,18,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Play all" Command="{Binding PlayHereCommand}" ToolTip="Play everything in this folder" Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Location}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="3" Margin="17,0,13,4" Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource TrackHeader}" />
            <TextBlock Grid.Column="2" Text="Time" Style="{StaticResource TrackHeader}" HorizontalAlignment="Right" />
        </Grid>

        <ListView Grid.Row="4" Margin="{StaticResource ScrollGutter}" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource TrackListItem}">
                    <Setter Property="Margin" Value="0,0,10,0" />
                    <Setter Property="res:Interaction.DoubleClickCommand" Value="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListView}}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" res:Interaction.FullTextToolTip="True" />
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,0,12,0" res:Interaction.FullTextToolTip="True" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource Subtle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE768;" ToolTip="Play"
                                    Visibility="{Binding IsPlayable, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding DataContext.PlayFromCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE768;" ToolTip="Play this folder"
                                    Visibility="{Binding IsContainer, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding DataContext.PlayContainerCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ProgressBar Grid.Row="4" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Grid.Row="4" Style="{StaticResource EmptyState}" Text="No media servers found on your network yet." Visibility="{Binding NoServers, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
