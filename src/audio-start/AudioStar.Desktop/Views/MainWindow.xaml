<Window x:Class="AudioStar.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioStar.Desktop.ViewModels"
        xmlns:views="clr-namespace:AudioStar.Desktop.Views"
        Title="Audio Star"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <Grid ContextMenuService.IsEnabled="{Binding HasSource}">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding ConnectText}" Command="{Binding ConnectCommand}" />
                        <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" Visibility="{Binding CanDisconnect, Converter={StaticResource BoolToVisibility}}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Button Style="{StaticResource NavButton}"
                        Tag="{Binding IsSelected}"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Key}"
                        AutomationProperties.Name="{Binding Label}"
                        HorizontalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Width="24"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SwitchButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                        Tag="{Binding IsOn}" Command="{Binding ToggleConnectionCommand}"
                        Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="{Binding ConnectText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NavGroupTemplate" DataType="{x:Type vm:NavGroup}">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Header}"
                           Style="{StaticResource Subtle}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="12,8,0,4" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NavItemTemplate}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SpeakerItemTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Info.Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Info.Model}" Style="{StaticResource Subtle}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14,12,10">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Speaker" Style="{StaticResource Subtle}" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,4" />
                    <ComboBox ItemsSource="{Binding Speakers}"
                              SelectedItem="{Binding SelectedSpeaker, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SpeakerItemTemplate}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Current speaker" />
                    <TextBlock Text="Searching for speakers on your network..."
                               Style="{StaticResource Subtle}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Margin="2,6,0,0"
                               Visibility="{Binding Player.NoSpeaker, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource NavGroupTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding Current}" Margin="0" />

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppStrokeBrush}" BorderThickness="0,1,0,0">
            <views:MiniBar DataContext="{Binding Player}" />
        </Border>

        <ItemsControl Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="16"
                      Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource AppToastBrush}"
                            CornerRadius="8"
                            Padding="14,10,6,10"
                            Margin="0,8,0,0"
                            MaxWidth="460"
                            BorderThickness="3,0,0,0"
                            BorderBrush="{DynamicResource AppAccentBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource IconButton}"
                                    Width="28"
                                    Height="28"
                                    FontSize="11"
                                    Content="&#xE711;"
                                    Foreground="White"
                                    Command="{Binding DismissCommand}"
                                    ToolTip="Dismiss" />
                            <TextBlock Text="{Binding Message}"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
